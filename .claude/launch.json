        "OPERATOR_PORT": "8808",
        "API_PORT": "8807",
        "WEB_PORT": "4193",
        "PROVIDER_URL": "http://127.0.0.1:8807",
        "OPERATOR_URL": "http://127.0.0.1:8808",
        "GAME_WEB_URL": "http://127.0.0.1:4193",
